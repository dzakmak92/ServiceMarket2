"""
stripe_payment_simulation.py
Full end-to-end Stripe payment simulation for ServiceMarket.
Tests every payment scenario using real Stripe test-mode API calls.
"""
import asyncio
import stripe
import requests
import time
import json
from datetime import datetime

# ── Config ────────────────────────────────────────────────────────────────────
import os
STRIPE_KEY    = os.environ.get("STRIPE_TEST_SECRET_KEY", "")  # set in .env — never hardcode
API_URL       = "https://pro-toolkit-hub.preview.emergentagent.com"
stripe.api_key = STRIPE_KEY

# Test payment tokens (Stripe built-in test tokens)
TOK_VISA          = "tok_visa"            # 4242... — succeeds
TOK_VISA_3DS      = "tok_visa"            # 3DS-eligible (use tok_threeDSecure2Required for strict 3DS)
TOK_DECLINED      = "tok_chargeDeclined"  # 4000...0002 — always declines
TOK_INSUF_FUNDS   = "tok_chargeDeclinedInsufficientFunds"

RESULTS = []

def log(emoji, msg):
    ts = datetime.now().strftime("%H:%M:%S")
    print(f"  [{ts}] {emoji}  {msg}")

def section(title):
    print(f"\n{'='*60}")
    print(f"  {title}")
    print(f"{'='*60}")

def record(scenario, status, detail=""):
    RESULTS.append({"scenario": scenario, "status": status, "detail": detail})
    icon = "✅" if status == "PASS" else "❌" if status == "FAIL" else "⚠️"
    print(f"  {icon} {scenario}: {detail}")

# ── Session helpers ───────────────────────────────────────────────────────────
session = requests.Session()

def login(email, password):
    r = session.post(f"{API_URL}/api/auth/login",
                     json={"email": email, "password": password})
    if r.status_code == 200:
        log("🔐", f"Logged in as {email}")
        return True
    log("❌", f"Login failed: {r.text[:100]}")
    return False

def logout():
    session.post(f"{API_URL}/api/auth/logout")

def get_sub_status():
    r = session.get(f"{API_URL}/api/billing/subscription-status")
    return r.json() if r.status_code == 200 else {}

def get_pro_profile():
    r = session.get(f"{API_URL}/api/profile/pro")
    return r.json() if r.status_code == 200 else {}

def confirm_payment_intent(pi_id, token=TOK_VISA):
    """Confirm a Stripe PaymentIntent with a test token."""
    pm = stripe.PaymentMethod.create(type="card", card={"token": token})
    pi = stripe.PaymentIntent.confirm(
        pi_id,
        payment_method=pm.id,
        return_url=f"{API_URL}/billing",
    )
    return pi

def get_checkout_pi(session_id):
    """Retrieve the PaymentIntent ID from a Checkout Session."""
    cs = stripe.checkout.Session.retrieve(session_id)
    return cs.payment_intent

def create_checkout(endpoint, **kwargs):
    """Create a checkout session via our API."""
    r = session.post(
        f"{API_URL}/api/billing/{endpoint}",
        json={"origin_url": API_URL},
        **kwargs
    )
    if r.status_code == 200:
        return r.json()
    log("❌", f"Checkout failed ({endpoint}): {r.status_code} {r.text[:120]}")
    return {}


# ─────────────────────────────────────────────────────────────────────────────
# SCENARIO 1 — Pro Plan Monthly Subscription
# ─────────────────────────────────────────────────────────────────────────────
def sim_pro_monthly():
    section("SCENARIO 1 — Pro Plan Monthly (€29.99 NET / €35.99 brutto)")
    login("sim_pro_monthly@test.com", "Test123!")

    data = create_checkout("checkout/subscription", params={"billing_period": "monthly"})
    if not data.get("url"):
        record("Pro Monthly — Checkout Session", "FAIL", "No URL returned")
        return
    sid = data["session_id"]
    log("🔗", f"Checkout URL: {data['url'][:70]}...")
    log("📋", f"Session ID: {sid}")
    record("Pro Monthly — Checkout Session Created", "PASS", f"Real Stripe session: {sid[:25]}...")

    # Confirm payment via Stripe API
    try:
        pi_id = get_checkout_pi(sid)
        if not pi_id:
            record("Pro Monthly — PaymentIntent Retrieved", "FAIL", "payment_intent is None on session")
            return
        log("💳", f"PaymentIntent: {pi_id} — confirming with Visa test card...")
        pi = confirm_payment_intent(pi_id, TOK_VISA)
        log("⚡", f"PaymentIntent status: {pi.status}")
        record("Pro Monthly — Payment Confirmed", "PASS" if pi.status == "succeeded" else "FAIL",
               f"PI status={pi.status} amount={pi.amount/100:.2f} {pi.currency.upper()}")
    except Exception as e:
        record("Pro Monthly — Payment Confirm", "FAIL", str(e)[:100])
        return

    # Wait for webhook delivery
    log("⏳", "Waiting 5s for webhook delivery...")
    time.sleep(5)

    # Verify activation
    status = get_sub_status()
    if status.get("plan_tier") == "pro":
        record("Pro Monthly — Plan Activated via Webhook", "PASS",
               f"plan_tier=pro, valid_until={status.get('sub_valid_until','?')[:10]}")
    else:
        # Try polling fallback
        r = session.get(f"{API_URL}/api/billing/checkout/status/{sid}")
        status = get_sub_status()
        if status.get("plan_tier") == "pro":
            record("Pro Monthly — Plan Activated via Poll", "PASS", "activated via polling fallback")
        else:
            record("Pro Monthly — Plan Activated", "FAIL",
                   f"plan_tier={status.get('plan_tier')} (expected 'pro')")

    logout()


# ─────────────────────────────────────────────────────────────────────────────
# SCENARIO 2 — Pro Plan Annual Subscription
# ─────────────────────────────────────────────────────────────────────────────
def sim_pro_annual():
    section("SCENARIO 2 — Pro Plan Annual (€299.90 NET / €359.88 brutto)")
    login("sim_pro_annual@test.com", "Test123!")

    data = create_checkout("checkout/subscription", params={"billing_period": "annual"})
    if not data.get("url"):
        record("Pro Annual — Checkout Session", "FAIL", "No URL returned")
        return
    sid = data["session_id"]
    log("🔗", f"Checkout URL: {data['url'][:70]}...")

    # Verify Stripe session amount
    cs = stripe.checkout.Session.retrieve(sid)
    expected_brutto = round(299.90 * 1.20 * 100)  # in cents
    actual = cs.amount_total
    amount_ok = abs(actual - expected_brutto) < 5  # allow 5 cent rounding tolerance
    record("Pro Annual — Amount Correct",
           "PASS" if amount_ok else "FAIL",
           f"Expected ~€{expected_brutto/100:.2f}, Stripe has €{actual/100:.2f}")

    try:
        pi_id = get_checkout_pi(sid)
        pi = confirm_payment_intent(pi_id, TOK_VISA)
        record("Pro Annual — Payment Confirmed", "PASS" if pi.status == "succeeded" else "FAIL",
               f"€{pi.amount/100:.2f} charged, billing_period=annual")
    except Exception as e:
        record("Pro Annual — Payment Confirm", "FAIL", str(e)[:100])
        return

    time.sleep(5)
    status = get_sub_status()
    bp = status.get("sub_billing_period", "?")
    plan = status.get("plan_tier", "?")
    days = status.get("days_remaining", 0)
    record("Pro Annual — Activation + Period",
           "PASS" if plan == "pro" and bp == "annual" and days > 360 else "FAIL",
           f"plan={plan}, period={bp}, days_remaining={days}")
    logout()


